[Unit]
Description=TJ Hotels - Frontend (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=tjhotels
Group=tjhotels
WorkingDirectory=/opt/tjhotels/frontend

# Only renders 3 templates; Caddy serves the static files.
ExecStart=/opt/tjhotels/venv/bin/gunicorn     --workers 1     --threads 4     --bind 127.0.0.1:5020     --timeout 30     --access-logfile -     --error-logfile -     "server:app"

Restart=on-failure
RestartSec=5

MemoryMax=150M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
