# Copy to .env and fill in real values. Never commit .env.

# Google Maps browser key — needs the Maps JavaScript API and Places API
# enabled. It ends up in the page, so restrict it by HTTP referrer
# (http://127.0.0.1:5020/*) in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Backend URL. Leave as is locally; behind Caddy use: /api
API_BASE=http://127.0.0.1:5010
