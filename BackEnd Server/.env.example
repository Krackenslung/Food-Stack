# Copy to .env and fill in real values. Never commit .env.

# Oracle Autonomous Database (wallet required: mTLS is mandatory)
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_DSN=tjhotels_low
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=

# Auth — JWT signing secret (generate a long random string)
JWT_SECRET=

# Session length in hours (JWT expiry and cookie max_age share this value)
TOKEN_HOURS=2

# CORS — origin of the FrontEnd Server
FRONTEND_ORIGIN=http://127.0.0.1:5020
