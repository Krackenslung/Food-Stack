SQL_SERVER=your-sql-server.database.windows.net
DATABASE=FoodStack
SQL_USER=foodstack_user
SQL_PASSWORD=replace-with-strong-password
SQL_DRIVER=ODBC Driver 18 for SQL Server
# SQL_TRUST_SERVER_CERT=yes   # local SQL Server with a self-signed certificate

# Security keys
JWT_SECRET_KEY=replace-with-long-random-secret
FLASK_SECRET_KEY=replace-with-another-long-random-secret

# CORS: only needed when the frontend runs on another origin (e.g. Vite dev server).
# Leave empty when Flask serves the frontend (same origin).
FRONTEND_ORIGIN=

# Core
APP_ENV=development

# Business config (defaults match the Figma numbers)
TAX_RATE=0.08
SERVICE_FEE=1.50
DELIVERY_FEE=2.99
STRIPE_CURRENCY=usd
STORE_NAME=FoodStack Zona Rio
STORE_ADDRESS=
STORE_TIMEZONE=America/Tijuana
STORE_HOURS=mon-sun 11:00-23:00

# Frontend (Vite, public). Only needed when the API is not on the same origin / proxy.
VITE_API_BASE_URL=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_GOOGLE_CLIENT_ID=

# Stripe (test keys outside production). Both are needed to enable card payments.
# Local webhooks: stripe listen --forward-to localhost:5000/api/payments/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
