SQL_SERVER=your-sql-server.database.windows.net
DATABASE=FoodStack
SQL_USER=foodstack_user
SQL_PASSWORD=replace-with-strong-password
SQL_DRIVER=ODBC Driver 18 for SQL Server
# SQL_TRUST_SERVER_CERT=yes   # local SQL Server with a self-signed certificate

# Security keys
JWT_SECRET_KEY=replace-with-long-random-secret
FLASK_SECRET_KEY=replace-with-another-long-random-secret

# CORS: only needed when the frontend runs on another origin (e.g. Vite dev server).
# Leave empty when Flask serves the frontend (same origin).
FRONTEND_ORIGIN=
